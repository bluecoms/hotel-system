        date = _pick(r, ["date","일자","입금일자","승인일자","거래일자","거래일시"]) 
        mtd  = _pick(r, ["method","방법","수단","결제수단","입금수단","은행","카드사","계좌","채널"]) or part_key_hint or "Unknown"
        amt  = _pick(r, ["입금금액","입금","거래금액","금액","입금액","수납금액"])  # 입금 계열만
        curr = _pick(r, ["currency","통화","화폐","CCY"]) or "KRW"
